    "vitest": "^2.1.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "@nx/gradle": "^22.0.0",
    "@nxlv/python": "^22.0.0",
    "turbo": "^2.3.0"
