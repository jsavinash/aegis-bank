{
  "plugins": [
    "@nx/js",
    "@nx/next",
    "@nx/react-native",
    "@nx/node",
    "@nx/gradle",
    "@nxlv/python"
  ],
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "cache": true,
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "cache": true
    }
  }
}